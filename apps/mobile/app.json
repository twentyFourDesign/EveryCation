{
  "expo": {
    "name": "EveryCation",
    "slug": "everycation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "everycation",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.everycation.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Approve wallet withdrawals with Face ID."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.everycation.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#002C82",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Approve wallet withdrawals with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002C82",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to add to your travel tips.",
          "cameraPermission": "Take photos and videos for your travel tips.",
          "microphonePermission": "Record sound with the videos for your travel tips."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice tips to share with other travellers.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EveryCation uses your location to fill in the town you are in when you share a tip.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "407d3f99-0bfc-4182-a36b-f7a4020be3c6"
      }
    }
  }
}
