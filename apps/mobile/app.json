{
  "expo": {
    "name": "EveryCation",
    "slug": "everycation",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "everycation",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.everycation.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Approve wallet withdrawals with Face ID."
      }
    },
    "android": {
      "package": "app.everycation.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#002C82",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Approve wallet withdrawals with Face ID."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#002C82",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos to add to your travel tips.",
          "cameraPermission": "Take photos and videos for your travel tips.",
          "microphonePermission": "Record sound with the videos for your travel tips."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}