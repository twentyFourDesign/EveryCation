# Where the API lives. On a real phone use your computer's LAN address, e.g. http://192.168.1.20:4000/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/v1
# Set to 1 to show the test-deposit button in a non-development build.
EXPO_PUBLIC_DEV_TOOLS=
# Map style. Leave empty for the free OpenFreeMap style (no key needed).
EXPO_PUBLIC_MAP_STYLE_URL=
