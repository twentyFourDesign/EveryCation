# Copy to .env for local development.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/everycation_dev
# 32+ random characters each. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_SECRET=change-me-too-change-me-too-change-me-too
# Shared secret the wallet partner signs webhooks with (HMAC SHA-256).
PARTNER_WEBHOOK_SECRET=change-me-partner-secret
# Where uploaded photos and videos are kept in development.
MEDIA_DIR=./uploads
# The address phones reach this API on, used in media links. On a real phone use your LAN address.
PUBLIC_URL=http://localhost:4000
