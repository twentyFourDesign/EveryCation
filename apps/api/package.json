{
  "name": "@everycation/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env dist/scripts/seed.js",
    "admin:create": "node --env-file-if-exists=.env dist/scripts/create-admin.js",
    "admin:code": "node --env-file-if-exists=.env dist/scripts/admin-code.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "type": "module"
}